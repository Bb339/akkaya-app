    try{
      let idx2 = null;
      try{ idx2 = await fetchJsonFirstV22(['data/_geojson_index.json', '/data/_geojson_index.json']); }catch(_eStatic){ idx2 = null; }
      if(idx2 && Array.isArray(idx2.files) && idx2.files.length){
        GEOJSON_FOLDER = idx2.base || 'data';
        GEOJSON_FILES = idx2.files.slice();
      }else{
        idx2 = await fetchJsonFirstV22(['data/geojson_yeni_klasor4/_index.json', '/data/geojson_yeni_klasor4/_index.json']);
        if(idx2 && Array.isArray(idx2.files) && idx2.files.length){
          GEOJSON_FOLDER = 'data/geojson_yeni_klasor4';
          GEOJSON_FILES = idx2.files.slice();
        }
      }
    }catch(_e2){
      // ignore
    }
  }

  try{ console.log('[GeoJSON] discovered', GEOJSON_FILES.length, 'files'); console.log('[GeoJSON] bahceli/sazlica', GEOJSON_FILES.filter(f=>String(f).toLowerCase().includes('bahceli')).length, GEOJSON_FILES.filter(f=>String(f).toLowerCase().includes('sazlica')).length); }catch(_e){}


