    if(idx && idx.status === 'OK' && Array.isArray(idx.files) && idx.files.length){
      GEOJSON_FOLDER = (idx.base || idx.folder || GEOJSON_FALLBACK_FOLDER);
      GEOJSON_FILES = idx.files.slice();
    }
  }catch(e){
    console.warn('GeoJSON index alınamadı, fallback liste kullanılacak.', e);
